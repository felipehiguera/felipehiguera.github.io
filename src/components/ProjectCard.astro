---
import PlaceholderMarco from "./PlaceholderMarco.astro";
import type { Proyecto } from "../db/portfolio";
import { etiquetaCategoria, fechaCorta } from "../db/portfolio";
import { baseUrl } from "../utils/base";

interface Props {
  proyecto: Pick<
    Proyecto,
    "slug" | "title" | "summary" | "date" | "category" | "cover"
  >;
  /**
   * Nivel del encabezado que envuelve el título enlazado.
   *
   * La tarjeta aparece bajo distintos encabezados padre: en `/proyectos` y
   * `/soporte-it` cuelga del `<h1>` de la página (nivel 2), mientras que en la
   * home vive dentro del `<h2>` "Proyectos destacados" (nivel 3). Dejar el
   * nivel fijo en 2 produciría un `<h2>` dentro de un `<h2>` y rompería la
   * jerarquía de encabezados.
   */
  nivel?: 2 | 3 | 4;
}

const { proyecto, nivel = 2 } = Astro.props;
const url = `${baseUrl()}proyectos/${proyecto.slug}`;

// Portadas de R2 (`/media/...`) o vacías. Van con <img> común: son WebP ya
// optimizados al subir, no necesitan el pipeline de astro:assets.
const coverUrl = proyecto.cover
  ? proyecto.cover.startsWith("/")
    ? `${baseUrl()}${proyecto.cover.replace(/^\//, "")}`
    : proyecto.cover
  : null;

// Red de seguridad: si el nivel llegara fuera de rango desde JS, emitimos un
// encabezado válido en vez de algo como `<h0>` o `<h7>`.
const nivelSeguro = nivel >= 2 && nivel <= 4 ? nivel : 2;
const Etiqueta = `h${nivelSeguro}`;
---

<article class="border p-4" style="border-color: var(--line)">
  {
    coverUrl ? (
      <img
        src={coverUrl}
        alt={`Portada del proyecto: ${proyecto.title}`}
        loading="lazy"
        class="block h-auto w-full"
      />
    ) : (
      <PlaceholderMarco label={`Portada pendiente — ${proyecto.title}`} />
    )
  }
  <p class="tech mt-3 text-xs" style="color: var(--muted)">
    {etiquetaCategoria(proyecto.category)} · {fechaCorta(proyecto.date)}
  </p>
  <Etiqueta class="mt-1 text-xl font-semibold">
    <a href={url}>{proyecto.title}</a>
  </Etiqueta>
  <p class="mt-2">{proyecto.summary}</p>
</article>
