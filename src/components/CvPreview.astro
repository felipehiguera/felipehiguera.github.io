---
/**
 * Vista previa del CV completo, hoja por hoja.
 *
 * Las imágenes se generan desde `public/cv/CV-Felipe-Higuera.pdf` con PyMuPDF
 * (`dpi=170`, sin el RUT). Se nombran `cv-pNN.png` y este componente las
 * descubre con `import.meta.glob`, así que agregar una hoja al PDF es volver a
 * renderizar: no hay que tocar código ni contar páginas a mano.
 *
 * Se usan imágenes y no un <iframe> con el visor nativo para no cargar los
 * ~360 KB del PDF en la página, para que en iOS el PDF embebido no se vea en
 * miniatura, y para que el texto siga siendo seleccionable por los buscadores.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { baseUrl } from "../utils/base";

const modulos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/cv-p*.png",
  { eager: true },
);

const hojas = Object.entries(modulos)
  .map(([ruta, modulo]) => ({
    numero: Number(/cv-p(\d+)\.png$/.exec(ruta)?.[1] ?? 0),
    imagen: modulo.default,
  }))
  .sort((a, b) => a.numero - b.numero)
  .map((hoja) => hoja.imagen);

const total = hojas.length;
const pdf = `${baseUrl()}cv/CV-Felipe-Higuera.pdf`;
---

{
  total > 0 && (
    <figure class="preview">
      <a href={pdf} target="_blank" rel="noopener">
        {hojas.map((hoja, i) => (
          <div class="hoja">
            <Image
              src={hoja}
              alt={`Hoja ${i + 1} de ${total} del currículum de Felipe Higuera: resumen profesional, experiencia laboral, educación y habilidades técnicas.`}
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 44rem, 92vw"
              loading="lazy"
              format="webp"
            />
          </div>
        ))}
        <span class="pie tech">Abrir el CV completo en PDF →</span>
      </a>
    </figure>
  )
}

<style>
  /* Mobile first: a pantalla completa; en desktop se limita a 44rem para que
     una hoja A4 se lea sin quedar diminuta ni estirarse más allá de lo cómodo. */
  .preview {
    margin-top: 2.5rem;
  }

  .preview a {
    display: block;
    border: 1px solid var(--line);
    background: var(--bg);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .preview a:hover {
    border-color: var(--accent);
  }

  .hoja {
    border-bottom: 1px solid var(--line);
  }

  /* `:global` porque el <img> lo emite <Image>, que tiene su propio ámbito. */
  .hoja :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pie {
    display: block;
    padding: 0.7rem 1rem;
    font-size: 0.75rem;
    color: var(--accent-ink);
  }

  @media (min-width: 768px) {
    .preview {
      max-width: 44rem;
    }
  }
</style>