---
import { baseUrl } from "../utils/base";

const base = baseUrl();

type Seccion = "proyectos" | "soporte-it" | "cv";

interface NavItem {
  href: string;
  label: string;
  /** Sección que gobierna este link, o `null` si siempre se muestra. */
  seccion: Seccion | null;
}

const { secciones = {} } = Astro.props as { secciones?: Record<string, boolean> };

const nav: NavItem[] = [
  { href: base, label: "Inicio", seccion: null },
  { href: `${base}proyectos`, label: "Proyectos", seccion: "proyectos" },
  { href: `${base}soporte-it`, label: "Soporte IT", seccion: "soporte-it" },
  { href: `${base}cv`, label: "CV", seccion: "cv" },
].filter((item) => item.seccion === null || secciones[item.seccion] !== false);

function normalize(path: string): string {
  return path.length > 1 ? path.replace(/\/$/, "") : path;
}

const current = normalize(Astro.url.pathname);
---

<header class="border-b" style="border-color: var(--line)">
  <div
    class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4"
  >
    <a
      href={base}
      class="flex items-center gap-3 no-underline"
      style="color: var(--fg)"
    >
      <!-- Compás de dibujo: misma marca que el favicon. -->
      <svg
        class="marca-icono"
        viewBox="0 0 32 32"
        fill="none"
        stroke-width="2.8"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M14.3 7.4 6.2 27.6"></path>
        <path d="M17.7 7.4 25.8 27.6"></path>
        <circle cx="16" cy="5.4" r="2.9" stroke="none"></circle>
      </svg>
      <span>
        <span class="block text-lg font-semibold leading-tight"
          >Felipe Higuera</span
        >
        <span class="tech block text-xs font-normal" style="color: var(--muted)">
          {/* El subtítulo completo no entra a 375 px junto al nav. */}
          <span class="sm:hidden">Dibujo técnico · CAD/CAM</span>
          <span class="hidden sm:inline"
            >Dibujo técnico · CAD/CAM · Soporte IT</span
          >
        </span>
      </span>
    </a>

    <nav aria-label="Navegación principal" class="w-full sm:ml-auto sm:w-auto">
      <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 sm:justify-end">
        {
          nav.map((item) => {
            const active = current === normalize(item.href);
            return (
              <li>
                <a href={item.href} aria-current={active ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    {/*
      Botón Admin: arranca oculto porque el sitio es estático y no sabe si hay
      sesión. El script de abajo lo revela solo si Access deja pasar a /admin.
      Sin sesión sigue oculto: no anuncia nada a nadie.
    */}
    <a
      href={`${base}admin`}
      id="admin-link"
      class="admin-link"
      hidden
    >
      Admin
    </a>
  </div>
</header>

<script define:vars={{ adminUrl: `${base}admin/` }}>
  (function () {
    var link = document.getElementById("admin-link");
    if (!link) return;
    // Sin seguir redirects: sin sesión Access responde 302 (opaco), con
    // sesión responde 200. Un solo GET a una página estática cacheada.
    fetch(adminUrl, { redirect: "manual" }).then(
      function (r) {
        if (r.status === 200) link.hidden = false;
      },
      function () {
        /* Sin red o sin acceso: el botón sigue oculto. */
      },
    );
  })();
</script>

<style>
  .marca-icono {
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    stroke: var(--accent);
  }

  .marca-icono circle {
    fill: var(--accent);
  }

  nav a {
    padding: 0.25rem 0;
  }

  /* Página activa: negrita + un punto. Es lo más discreto que aún se
     distingue sin depender solo del color. */
  nav a[aria-current="page"] {
    font-weight: 700;
  }

  nav a[aria-current="page"]::before {
    content: "";
    display: inline-block;
    width: 0.3125rem;
    height: 0.3125rem;
    margin-right: 0.45rem;
    border-radius: 999px;
    background: currentColor;
    vertical-align: 0.125rem;
  }

  .admin-link {
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    text-decoration: none;
  }

  /* En móvil el botón queda en su propia línea: centrado como el nav. */
  @media (max-width: 639px) {
    .admin-link {
      margin-inline: auto;
    }
  }

  .admin-link:hover {
    border-color: var(--accent);
  }
</style>