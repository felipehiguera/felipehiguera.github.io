---
import { baseUrl } from "../utils/base";

interface Props {
  /** Título del plano. */
  title: string;
  /** URL del PDF (ruta /media/... de R2 o relativa a `public`). */
  pdf: string;
}

const { title, pdf } = Astro.props;
// Acepta URLs absolutas de R2 y rutas viejas relativas a `public`.
const pdfUrl = /^https?:\/\//.test(pdf)
  ? pdf
  : `${baseUrl()}${pdf.replace(/^\//, "")}`;
---

<figure class="overflow-x-auto border p-2" style="border-color: var(--line)">
  <a href={pdfUrl} target="_blank" rel="noopener" type="application/pdf">
    <span
      class="tech block p-8 text-center text-sm"
      style="color: var(--muted); background: var(--code-bg)"
    >
      {title}
    </span>
  </a>
  <figcaption class="mt-2 flex flex-wrap items-baseline justify-between gap-2 text-sm">
    <span>{title}</span>
    <span class="tech flex gap-4 text-xs">
      <a href={pdfUrl} target="_blank" rel="noopener" type="application/pdf">
        Ver PDF
      </a>
      <a href={pdfUrl} download>
        Descargar
      </a>
    </span>
  </figcaption>
</figure>
