---
/**
 * El teléfono se muestra como la palabra "Teléfono" y no como el número: el
 * enlace `tel:` abre igual el marcador o la app de llamadas del dispositivo,
 * pero así el número no queda en el texto plano de la página.
 *
 * El `aria-label` hace dos cosas: describe el enlace cuando se lee fuera de
 * contexto (una lista de enlaces suelta no dice a quién llama), e incluye la
 * palabra visible, que es lo que exige WCAG 2.5.3 (Label in Name).
 */
const year = new Date().getFullYear();
---

<footer class="border-t" style="border-color: var(--line)">
  <div class="mx-auto max-w-4xl px-4 py-8 text-sm" style="color: var(--muted)">
    <p class="font-semibold" style="color: var(--fg)">Contacto</p>
    <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
      <li>
        <a href="mailto:felipehiguera@outlook.cl">felipehiguera@outlook.cl</a>
      </li>
      <li>
        <a href="tel:+56931110973" aria-label="Teléfono: llamar al +56 9 3111 0973"
          >Teléfono</a
        >
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/felipe-h-321316284/"
          target="_blank"
          rel="me noopener"
        >
          LinkedIn
        </a>
      </li>
    </ul>
    <p class="tech mt-4 text-xs">
      Maipú, Santiago, Chile · © {year} Felipe Higuera
    </p>
  </div>
</footer>
