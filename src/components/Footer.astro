---
/**
 * Los tres datos de contacto se muestran con su etiqueta ("Correo",
 * "Teléfono", "LinkedIn") y no con el dato crudo, pero cada enlace sigue
 * llevando a su destino real: `mailto:`, `tel:` y el perfil de LinkedIn.
 *
 * Los `aria-label` hacen dos cosas: describen el enlace cuando se lee fuera de
 * contexto (una lista de enlaces suelta no dice a quién lleva), e incluyen la
 * palabra visible, que es lo que exige WCAG 2.5.3 (Label in Name).
 */
const year = new Date().getFullYear();
---

<footer class="border-t" style="border-color: var(--line)">
  <div class="mx-auto max-w-4xl px-4 py-8 text-sm" style="color: var(--muted)">
    <p class="font-semibold" style="color: var(--fg)">Contacto</p>
    <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
      <li>
        <a
          href="mailto:felipehiguera@outlook.cl"
          aria-label="Correo: escribir a felipehiguera@outlook.cl"
          class="inline-flex items-center gap-1.5"
        >
          <svg
            class="contacto-icono"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"><rect x="2" y="4" width="20" height="16" rx="2" /><path
              d="m22 7-10 6L2 7"
            /></svg>
          Correo
        </a>
      </li>
      <li>
        <a
          href="tel:+56931110973"
          aria-label="Teléfono: llamar al +56 9 3111 0973"
          class="inline-flex items-center gap-1.5"
          ><svg
            class="contacto-icono"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
            /></svg
          >Teléfono</a
        >
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/felipe-h-321316284/"
          target="_blank"
          rel="me noopener"
          aria-label="LinkedIn: perfil de Felipe Higuera"
          class="inline-flex items-center gap-1.5"
        >
          <svg
            class="contacto-icono"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            ><path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"
            /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2"
            /></svg>
          LinkedIn
        </a>
      </li>
    </ul>
    <p class="tech mt-4 text-xs">
      Maipú, Santiago, Chile · © {year} Felipe Higuera
    </p>
  </div>
</footer>

<style>
  /* Iconos de trazo, del mismo grosor y con `currentColor` para que hereden
     el color del enlace. Son decorativos: el texto y el aria-label ya dan el
     significado, asi que se ocultan al lector de pantalla. */
  .contacto-icono {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
</style>
