---
import { getCollection } from "astro:content";
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import DestacadosCarousel from "../components/DestacadosCarousel.astro";

const destacados = (await getCollection("proyectos", ({ data }) => data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
const cvExiste = existsSync("public/cv/CV-Felipe-Higuera.pdf");
---

<Base
  title="Felipe Higuera — Dibujo técnico industrial, CAD/CAM y Soporte IT"
  description="Portafolio de Felipe Higuera: dibujo técnico industrial, modelado CAD/CAM y soporte IT. Planos, modelos y proceso."
>
  <Hero />

  <section aria-labelledby="destacados" class="mx-auto max-w-4xl px-4 py-10">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="destacados" class="text-2xl font-bold">Proyectos destacados</h2>
      <a href={`${base}proyectos`}>Ver todos →</a>
    </div>
    <div class="mt-6">
      <DestacadosCarousel proyectos={destacados} />
    </div>
  </section>

  <section aria-labelledby="cv" class="mx-auto max-w-4xl px-4 pb-14">
    <h2 id="cv" class="text-2xl font-bold">Currículum</h2>
    <p class="mt-2 max-w-prose" style="color: var(--muted)">
      Resumen de experiencia, formación y habilidades, con descarga en PDF.
    </p>
    <p class="mt-4">
      <a href={`${base}cv`}>Ver CV completo →</a>
    </p>
    <p class="mt-2">
      {
        cvExiste ? (
          <a href={`${base}cv/CV-Felipe-Higuera.pdf`} download>
            Descargar PDF
          </a>
        ) : (
          <span class="tech text-sm" style="color: var(--muted)">
            TODO: PDF del CV pendiente (public/cv/CV-Felipe-Higuera.pdf)
          </span>
        )
      }
    </p>
  </section>
</Base>