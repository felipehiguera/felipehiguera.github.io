---
import Base from "../../layouts/Base.astro";
import ModelViewer from "../../components/ModelViewer.astro";
import PlaceholderMarco from "../../components/PlaceholderMarco.astro";
import PlanoEmbed from "../../components/PlanoEmbed.astro";
import SpecList from "../../components/SpecList.astro";
import {
  cuerpoAHtml,
  etiquetaCategoria,
  fechaCorta,
  getDB,
  leerProyecto,
} from "../../db/portfolio";
import { baseUrl } from "../../utils/base";

// SSR: la ruta se resuelve en cada request contra D1. Los borradores no
// existen acá (leerProyecto los filtra): despublicar sigue siendo real.
const slug = Astro.params.slug ?? "";
const data = await leerProyecto(getDB(), slug);

if (!data) {
  return new Response("Proyecto no encontrado", { status: 404 });
}

const entregable: string[] = [
  ...(data.model ? [`Modelo 3D: ${data.model}`] : []),
  ...data.planos.map((p) => `Plano: ${p.title || p.url}`),
];
const base = baseUrl();
// `article:published_time` espera ISO 8601; `<time datetime>` solo la fecha.
const fechaIso = `${data.date}T00:00:00Z`;
const fechaSolo = data.date.slice(0, 10);
const html = cuerpoAHtml(data.body);
---

<Base
  title={`${data.title} — Felipe Higuera`}
  description={data.summary}
  ogType="article"
  publishedTime={fechaIso}
  section={etiquetaCategoria(data.category)}
>
  <article
    class="mx-auto max-w-4xl px-4 py-10"
    aria-labelledby="titulo-proyecto"
  >
    <p class="flex flex-wrap items-center justify-between gap-2">
      <a href={`${base}proyectos`}>← Volver a proyectos</a>
      {/*
        Solo visible con sesión de Access: el probe de abajo lo revela si el
        navegador pasa a /admin. Es el atajo "editar mientras veo mis posts".
      */}
      <a
        href={`${base}admin/?editar=${data.slug}`}
        id="editar-proyecto"
        class="admin-editar"
        hidden
      >
        Editar este proyecto →
      </a>
    </p>
    {
      data.confidential && (
        <p role="note" class="mt-4 border p-4 text-sm" style="border-color: var(--line)">
          Aviso: material confidencial redactado. Se muestra solo una versión
          descriptiva, sin planos ni datos sensibles.
        </p>
      )
    }
    <p class="tech mt-6 text-xs uppercase tracking-widest" style="color: var(--muted)">
      {etiquetaCategoria(data.category)} ·{" "}
      <time datetime={fechaSolo}>{fechaCorta(data.date)}</time>
    </p>
    <h1 id="titulo-proyecto" class="mt-2 text-3xl font-bold">{data.title}</h1>
    <p class="mt-2 max-w-prose text-lg">{data.summary}</p>

    <div class="mt-6 border-y py-4" style="border-color: var(--line)">
      <SpecList
        software={data.software}
        normativa={data.normativa}
        entregable={entregable}
      />
    </div>

    {
      data.cover ? (
        <img
          src={
            data.cover.startsWith("/")
              ? `${base}${data.cover.replace(/^\//, "")}`
              : data.cover
          }
          alt={`Portada del proyecto: ${data.title}`}
          loading="lazy"
          class="mt-6 block h-auto w-full"
        />
      ) : (
        <div class="mt-6">
          <PlaceholderMarco label={`Portada pendiente — ${data.title}`} />
        </div>
      )
    }

    {
      data.model ? (
        <div class="mt-6">
          <ModelViewer
            src={data.model}
            title={`Modelo 3D — ${data.title}`}
            alt={`Modelo 3D del proyecto: ${data.title}`}
          />
        </div>
      ) : (
        <p class="tech mt-6 border p-4 text-sm" style="border-color: var(--line); color: var(--muted)">
          Sin modelo 3D todavía.
        </p>
      )
    }

    {
      data.planos.length > 0 ? (
        <ul class="mt-6 grid gap-6">
          {data.planos.map((plano) => (
            <li>
              <PlanoEmbed title={plano.title || plano.url} pdf={plano.url} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="tech mt-6 border p-4 text-sm" style="border-color: var(--line); color: var(--muted)">
          Sin planos todavía.
        </p>
      )
    }

    <div class="prose mt-8 max-w-prose" set:html={html} />
  </article>

  {/*
    Edición rápida sobre la página. Solo existe en el DOM para admins: el
    probe revela el botón con sesión, y Access frena todo lo demás.
  */}
  <button type="button" id="er-abrir" class="er-flotante" hidden>
    ✎ Editar
  </button>
  <div id="er-velo" class="er-velo" hidden></div>
  <aside
    id="er-panel"
    class="er-panel"
    hidden
    aria-label="Edición rápida del proyecto"
  >
    <h2 class="text-lg font-bold">Edición rápida</h2>
    <label>
      Título
      <input id="er-title" type="text" autocomplete="off" />
    </label>
    <label>
      Resumen
      <input id="er-summary" type="text" autocomplete="off" />
    </label>
    <label>
      Fecha
      <input id="er-date" type="date" />
    </label>
    <label>
      Categoría
      <select id="er-category">
        <option value="dibujo-tecnico">Dibujo técnico</option>
        <option value="cad-cam">CAD/CAM</option>
        <option value="soporte-it">Soporte IT</option>
      </select>
    </label>
    <label class="er-check">
      <input id="er-featured" type="checkbox" />
      Destacado en el home
    </label>
    <label class="er-check">
      <input id="er-draft" type="checkbox" />
      Borrador (oculto y sin ruta)
    </label>
    <div>
      <span class="text-sm font-semibold">Portada</span>
      <img id="er-vista" class="er-vista mt-2" alt="" hidden />
      <input id="er-file" type="file" accept="image/*" class="mt-2 text-sm" />
    </div>
    <p id="er-estado" class="er-estado" role="status"></p>
    <div class="er-fila">
      <button type="button" id="er-guardar" class="er-btn primario">
        Guardar
      </button>
      <button type="button" id="er-cancelar" class="er-btn">
        Cancelar
      </button>
    </div>
    <p class="text-xs" style="color: var(--muted)">
      Para el texto completo, planos y modelo, usá el
      <a href={`${base}admin/`}>editor completo</a>.
    </p>
  </aside>
</Base>

<style>
  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2rem;
  }
  .prose :global(p) {
    margin-top: 0.75rem;
  }

  .admin-editar {
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .admin-editar:hover {
    border-color: var(--accent);
  }

  /* Edición rápida: botón flotante + panel lateral, solo con sesión. */
  .er-flotante {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.7rem 1.3rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.2);
  }

  @media (prefers-color-scheme: dark) {
    .er-flotante {
      color: #101418;
    }
  }

  .er-velo {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(0 0 0 / 0.4);
  }

  .er-panel {
    position: fixed;
    z-index: 41;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    padding: 1.25rem;
    display: grid;
    gap: 0.8rem;
    overflow-y: auto;
    inset: auto 0 0 0;
    max-height: 92svh;
    border-radius: 0.75rem 0.75rem 0 0;
  }

  @media (min-width: 640px) {
    .er-panel {
      inset: 0 0 0 auto;
      width: min(26rem, 92vw);
      max-height: none;
      border-radius: 0;
      border-top: 0;
      border-right: 0;
      border-bottom: 0;
    }
  }

  .er-panel label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .er-panel input:not([type="checkbox"]):not([type="file"]),
  .er-panel select {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    padding: 0.5rem 0.65rem;
    border-radius: 0.375rem;
    font: inherit;
    font-weight: 400;
  }

  .er-panel input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--accent);
  }

  .er-check {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 0.6rem;
    font-weight: 400 !important;
  }

  .er-vista {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
  }

  .er-fila {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }

  .er-btn {
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--accent-ink);
    padding: 0.55rem 1.1rem;
    border-radius: 0.375rem;
    font: inherit;
    cursor: pointer;
    min-height: 2.75rem;
  }

  .er-btn.primario {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  @media (prefers-color-scheme: dark) {
    .er-btn.primario {
      color: #101418;
    }
  }

  .er-btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .er-estado {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .er-estado.error {
    color: #b3261e;
  }
</style>

<script define:vars={{ adminUrl: `${base}admin/`, slug: data.slug, apiUrl: `${base}admin/api` }}>
  (function () {
    var link = document.getElementById("editar-proyecto");
    var flotante = document.getElementById("er-abrir");
    var panel = document.getElementById("er-panel");
    var velo = document.getElementById("er-velo");
    var estado = document.getElementById("er-estado");
    var guardarBtn = document.getElementById("er-guardar");
    var actual = null;

    function mostrar(v) {
      panel.hidden = !v;
      velo.hidden = !v;
    }

    function api(accion, extra) {
      return fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.assign({ accion: accion }, extra)),
      }).then(function (r) {
        return r.json();
      });
    }

    function vistaCover(url) {
      var img = document.getElementById("er-vista");
      if (url) {
        img.src = url;
        img.hidden = false;
      } else {
        img.removeAttribute("src");
        img.hidden = true;
      }
    }

    function abrir() {
      estado.textContent = "Cargando…";
      estado.className = "er-estado";
      mostrar(true);
      api("proyectos.leer", { slug: slug }).then(
        function (r) {
          if (!r.ok || !r.proyecto) throw new Error(r.error || "No se pudo leer");
          actual = r.proyecto;
          document.getElementById("er-title").value = actual.title || "";
          document.getElementById("er-summary").value = actual.summary || "";
          document.getElementById("er-date").value = (actual.date || "").slice(0, 10);
          document.getElementById("er-category").value = actual.category || "dibujo-tecnico";
          document.getElementById("er-featured").checked = !!actual.featured;
          document.getElementById("er-draft").checked = !!actual.draft;
          vistaCover(actual.cover);
          estado.textContent = "";
        },
        function (e) {
          estado.textContent = e.message || "No se pudo cargar";
          estado.className = "er-estado error";
        },
      );
    }

    function achicar(file) {
      return new Promise(function (res, rej) {
        var img = new Image();
        var url = URL.createObjectURL(file);
        img.onload = function () {
          URL.revokeObjectURL(url);
          var escala = Math.min(1, 1600 / Math.max(img.width, img.height));
          var c = document.createElement("canvas");
          c.width = Math.max(1, Math.round(img.width * escala));
          c.height = Math.max(1, Math.round(img.height * escala));
          c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
          var d = c.toDataURL("image/webp", 0.82);
          if (d.indexOf("data:image/webp") !== 0) rej(new Error("No se pudo convertir"));
          else res(d.split(",")[1]);
        };
        img.onerror = function () {
          URL.revokeObjectURL(url);
          rej(new Error("Archivo no legible"));
        };
        img.src = url;
      });
    }

    function guardar() {
      if (!actual) return;
      guardarBtn.disabled = true;
      estado.textContent = "Guardando…";
      estado.className = "er-estado";

      var file = document.getElementById("er-file").files[0];
      var trabajo = Promise.resolve(null);
      if (file) {
        estado.textContent = "Subiendo portada…";
        trabajo = achicar(file).then(function (b64) {
          return api("media.subir", {
            tipo: "portada",
            slug: actual.slug,
            nombre: file.name,
            base64: b64,
          }).then(function (r) {
            if (!r.ok || !r.url) throw new Error(r.error || "No se pudo subir");
            return r.url;
          });
        });
      }

      trabajo.then(
        function (cover) {
          var body = {
            slug: actual.slug,
            slugOriginal: actual.slug,
            title: document.getElementById("er-title").value.trim(),
            summary: document.getElementById("er-summary").value.trim(),
            date: document.getElementById("er-date").value,
            category: document.getElementById("er-category").value,
            featured: document.getElementById("er-featured").checked,
            draft: document.getElementById("er-draft").checked,
            confidential: actual.confidential,
            software: actual.software,
            normativa: actual.normativa,
            cover: cover || actual.cover,
            model: actual.model,
            planos: actual.planos,
            body: actual.body,
          };
          if (!body.title) throw new Error("Falta el título");
          estado.textContent = "Guardando…";
          return api("proyectos.guardar", { proyecto: body });
        },
      ).then(
        function (r) {
          if (!r.ok) throw new Error(r.error || "No se pudo guardar");
          estado.textContent = "Listo, recargando…";
          // Recarga evitando el caché edge para ver los cambios al tiro.
          fetch(location.href.split("?")[0], {
            headers: { "Cache-Control": "no-cache" },
          }).finally(function () {
            location.reload();
          });
        },
        function (e) {
          guardarBtn.disabled = false;
          estado.textContent = e.message || "No se pudo guardar";
          estado.className = "er-estado error";
        },
      );
    }

    if (flotante) flotante.addEventListener("click", abrir);
    if (guardarBtn) guardarBtn.addEventListener("click", guardar);
    document.getElementById("er-cancelar").addEventListener("click", function () {
      mostrar(false);
    });
    velo.addEventListener("click", function () {
      mostrar(false);
    });

    // El probe revela el link y el botón solo con sesión de Access.
    fetch(adminUrl, { redirect: "manual" }).then(
      function (r) {
        if (r.status === 200) {
          link.hidden = false;
          flotante.hidden = false;
        }
      },
      function () {},
    );
  })();
</script>
