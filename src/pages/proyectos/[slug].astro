---
import Base from "../../layouts/Base.astro";
import ModelViewer from "../../components/ModelViewer.astro";
import PlaceholderMarco from "../../components/PlaceholderMarco.astro";
import PlanoEmbed from "../../components/PlanoEmbed.astro";
import SpecList from "../../components/SpecList.astro";
import Icono from "../../components/Icono.astro";
import {
  cuerpoAHtml,
  etiquetaCategoria,
  fechaCorta,
  getDB,
  leerProyecto,
} from "../../db/portfolio";
import { baseUrl } from "../../utils/base";

// SSR: la ruta se resuelve en cada request contra D1. Los borradores no
// existen acá (leerProyecto los filtra): despublicar sigue siendo real.
const slug = Astro.params.slug ?? "";
const data = await leerProyecto(getDB(), slug);

if (!data) {
  return new Response("Proyecto no encontrado", { status: 404 });
}

const entregable: string[] = [
  ...(data.model ? [`Modelo 3D: ${data.model}`] : []),
  ...data.planos.map((p) => `Plano: ${p.title || p.url}`),
];
const base = baseUrl();
// `article:published_time` espera ISO 8601; `<time datetime>` solo la fecha.
const fechaIso = `${data.date}T00:00:00Z`;
const fechaSolo = data.date.slice(0, 10);
const html = cuerpoAHtml(data.body);
---

<Base
  title={`${data.title} — Felipe Higuera`}
  description={data.summary}
  ogType="article"
  publishedTime={fechaIso}
  section={etiquetaCategoria(data.category)}
>
  <article
    class="mx-auto max-w-4xl px-4 py-10"
    aria-labelledby="titulo-proyecto"
  >
    <p class="flex flex-wrap items-center justify-between gap-2">
      <a href={`${base}proyectos`}>← Volver a proyectos</a>
      {/*
        Solo visible con sesión de Access: el probe de abajo lo revela si el
        navegador pasa a /admin. Es el atajo "editar mientras veo mis posts".
      */}
      <a
        href={`${base}admin/?editar=${data.slug}`}
        id="editar-proyecto"
        class="admin-editar"
        hidden
      >
        Editar este proyecto →
      </a>
    </p>
    {
      data.confidential && (
        <p role="note" class="mt-4 border p-4 text-sm" style="border-color: var(--line)">
          Aviso: material confidencial redactado. Se muestra solo una versión
          descriptiva, sin planos ni datos sensibles.
        </p>
      )
    }
    <p class="tech mt-6 text-xs uppercase tracking-widest" style="color: var(--muted)">
      {etiquetaCategoria(data.category)} ·{" "}
      <time datetime={fechaSolo}>{fechaCorta(data.date)}</time>
    </p>
    <h1 id="titulo-proyecto" class="mt-2 text-3xl font-bold">{data.title}</h1>
    <p class="mt-2 max-w-prose text-lg">{data.summary}</p>

    <div class="mt-6 border-y py-4" style="border-color: var(--line)">
      <SpecList
        software={data.software}
        normativa={data.normativa}
        entregable={entregable}
      />
    </div>

    {
      data.cover ? (
        <img
          src={
            data.cover.startsWith("/")
              ? `${base}${data.cover.replace(/^\//, "")}`
              : data.cover
          }
          alt={`Portada del proyecto: ${data.title}`}
          loading="lazy"
          class="mt-6 block h-auto w-full"
        />
      ) : (
        <div class="mt-6">
          <PlaceholderMarco label={`Portada pendiente — ${data.title}`} />
        </div>
      )
    }

    {
      data.model ? (
        <div class="mt-6">
          <ModelViewer
            src={data.model}
            title={`Modelo 3D — ${data.title}`}
            alt={`Modelo 3D del proyecto: ${data.title}`}
          />
        </div>
      ) : (
        <p class="tech mt-6 border p-4 text-sm" style="border-color: var(--line); color: var(--muted)">
          Sin modelo 3D todavía.
        </p>
      )
    }

    {
      data.planos.length > 0 ? (
        <ul class="mt-6 grid gap-6">
          {data.planos.map((plano) => (
            <li>
              <PlanoEmbed title={plano.title || plano.url} pdf={plano.url} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="tech mt-6 border p-4 text-sm" style="border-color: var(--line); color: var(--muted)">
          Sin planos todavía.
        </p>
      )
    }

    <div class="prose mt-8 max-w-prose" set:html={html} />
  </article>

  {/*
    Edición rápida sobre la página. Solo existe en el DOM para admins: el
    probe revela el botón con sesión, y Access frena todo lo demás.
  */}
  <button type="button" id="er-abrir" class="er-flotante" hidden>
    <Icono nombre="lapiz" /> Editar
  </button>
  {/*
    Editor completo en modal: iframe al /admin con modo embed (sin lista ni
    secciones, abre el editor directo). Cero duplicación: es el mismo
    formulario, así que toda mejora futura aparece acá sola.
  */}
  <div id="er-modal" hidden>
    <div id="er-velo" class="er-velo"></div>
    <div class="er-modal" role="dialog" aria-modal="true" aria-label="Editar proyecto">
      <div class="er-modal-barra">
        <strong>Editar proyecto</strong>
        <button type="button" id="er-cerrar" class="er-btn">Cerrar ✕</button>
      </div>
      <iframe
        id="er-frame"
        title="Editor del proyecto"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</Base>

<style>
  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2rem;
  }
  .prose :global(p) {
    margin-top: 0.75rem;
  }

  .admin-editar {
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    padding: 0.3rem 0.8rem;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .admin-editar:hover {
    border-color: var(--accent);
  }

  /* Edición rápida: botón flotante + panel lateral, solo con sesión. */
  .er-flotante {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.7rem 1.3rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.2);
  }

  @media (prefers-color-scheme: dark) {
    .er-flotante {
      color: #101418;
    }
  }

  .er-flotante {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .er-velo {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(0 0 0 / 0.6);
  }

  /* Modal con el editor completo adentro (iframe al /admin en modo embed).
     En mobile ocupa casi todo; en desktop, ventana centrada. */
  #er-modal[hidden] {
    display: none;
  }

  .er-modal {
    position: fixed;
    z-index: 41;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 4svh 1rem 1rem;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .er-modal {
      padding: 5svh 2rem 2rem;
    }
  }

  .er-modal-barra {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 0.75rem 0.75rem 0 0;
    padding: 0.7rem 1rem;
    max-width: 56rem;
    width: 100%;
    margin: 0 auto;
  }

  .er-modal iframe {
    pointer-events: auto;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 0 0 0.75rem 0.75rem;
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    height: 100%;
    min-height: 0;
  }

  .er-btn {
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--accent-ink);
    padding: 0.45rem 0.9rem;
    border-radius: 0.375rem;
    font: inherit;
    cursor: pointer;
  }

  .er-btn:hover {
    border-color: var(--accent);
  }
</style>

<script define:vars={{ adminUrl: `${base}admin/`, slug: data.slug }}>
  (function () {
    var link = document.getElementById("editar-proyecto");
    var flotante = document.getElementById("er-abrir");
    var modal = document.getElementById("er-modal");
    var velo = document.getElementById("er-velo");
    var frame = document.getElementById("er-frame");
    var cargado = false;

    function abrir() {
      var url = adminUrl + "?editar=" + encodeURIComponent(slug) + "&embed=1";
      try {
        // Si ya estaba cargado (se editó y cerró antes), se recarga para que
        // el editor se abra de nuevo en vez de mostrar el estado viejo.
        if (cargado && frame.contentWindow) {
          frame.contentWindow.location.reload();
        } else {
          frame.src = url;
          cargado = true;
        }
      } catch (e) {
        frame.src = url;
        cargado = true;
      }
      modal.hidden = false;
      document.body.style.overflow = "hidden";
    }

    function cerrar() {
      modal.hidden = true;
      document.body.style.overflow = "";
    }

    // El link superior abre el mismo modal en vez de navegar al admin
    // (si el JS falla, el href sigue llevando al editor completo).
    if (link) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        abrir();
      });
    }
    if (flotante) flotante.addEventListener("click", abrir);
    document.getElementById("er-cerrar").addEventListener("click", cerrar);
    velo.addEventListener("click", cerrar);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !modal.hidden) cerrar();
    });

    // El iframe avisa al guardar: se regenera sin caché y se recarga.
    // Al cancelar, solo se cierra el modal.
    window.addEventListener("message", function (e) {
      if (e.origin !== location.origin) return;
      if (!e.data) return;
      if (e.data.tipo === "editor-cerrado") {
        cerrar();
        return;
      }
      if (e.data.tipo !== "proyecto-guardado") return;
      fetch(location.href.split("?")[0], {
        headers: { "Cache-Control": "no-cache" },
      }).finally(function () {
        location.reload();
      });
    });

    // El probe revela el link y el botón solo con sesión de Access.
    fetch(adminUrl, { redirect: "manual" }).then(
      function (r) {
        if (r.status === 200) {
          if (link) link.hidden = false;
          if (flotante) flotante.hidden = false;
        }
      },
      function () {},
    );
  })();
</script>


