---
import Base from "../../layouts/Base.astro";
import ModelViewer from "../../components/ModelViewer.astro";
import PlaceholderMarco from "../../components/PlaceholderMarco.astro";
import PlanoEmbed from "../../components/PlanoEmbed.astro";
import SpecList from "../../components/SpecList.astro";
import {
  cuerpoAHtml,
  etiquetaCategoria,
  fechaCorta,
  getDB,
  leerProyecto,
} from "../../db/portfolio";
import { baseUrl } from "../../utils/base";

// SSR: la ruta se resuelve en cada request contra D1. Los borradores no
// existen acá (leerProyecto los filtra): despublicar sigue siendo real.
const slug = Astro.params.slug ?? "";
const data = await leerProyecto(getDB(), slug);

if (!data) {
  return new Response("Proyecto no encontrado", { status: 404 });
}

const entregable: string[] = [
  ...(data.model ? [`Modelo 3D: ${data.model}`] : []),
  ...data.planos.map((p) => `Plano: ${p.title || p.url}`),
];
const base = baseUrl();
// `article:published_time` espera ISO 8601; `<time datetime>` solo la fecha.
const fechaIso = `${data.date}T00:00:00Z`;
const fechaSolo = data.date.slice(0, 10);
const html = cuerpoAHtml(data.body);
---

<Base
  title={`${data.title} — Felipe Higuera`}
  description={data.summary}
  ogType="article"
  publishedTime={fechaIso}
  section={etiquetaCategoria(data.category)}
>
  <article
    class="mx-auto max-w-4xl px-4 py-10"
    aria-labelledby="titulo-proyecto"
  >
    <p>
      <a href={`${base}proyectos`}>← Volver a proyectos</a>
    </p>
    {
      data.confidential && (
        <p role="note" class="mt-4 border p-4 text-sm" style="border-color: var(--line)">
          Aviso: material confidencial redactado. Se muestra solo una versión
          descriptiva, sin planos ni datos sensibles.
        </p>
      )
    }
    <p class="tech mt-6 text-xs uppercase tracking-widest" style="color: var(--muted)">
      {etiquetaCategoria(data.category)} ·{" "}
      <time datetime={fechaSolo}>{fechaCorta(data.date)}</time>
    </p>
    <h1 id="titulo-proyecto" class="mt-2 text-3xl font-bold">{data.title}</h1>
    <p class="mt-2 max-w-prose text-lg">{data.summary}</p>

    <div class="mt-6 border-y py-4" style="border-color: var(--line)">
      <SpecList
        software={data.software}
        normativa={data.normativa}
        entregable={entregable}
      />
    </div>

    {
      data.cover ? (
        <img
          src={
            data.cover.startsWith("/")
              ? `${base}${data.cover.replace(/^\//, "")}`
              : data.cover
          }
          alt={`Portada del proyecto: ${data.title}`}
          loading="lazy"
          class="mt-6 block h-auto w-full"
        />
      ) : (
        <div class="mt-6">
          <PlaceholderMarco label={`Portada pendiente — ${data.title}`} />
        </div>
      )
    }

    {
      data.model ? (
        <div class="mt-6">
          <ModelViewer
            src={data.model}
            title={`Modelo 3D — ${data.title}`}
            alt={`Modelo 3D del proyecto: ${data.title}`}
          />
        </div>
      ) : (
        <p class="tech mt-6 border p-4 text-sm" style="border-color: var(--line); color: var(--muted)">
          TODO: visor 3D pendiente (subir el .glb desde el panel como modelo).
        </p>
      )
    }

    {
      data.planos.length > 0 ? (
        <ul class="mt-6 grid gap-6">
          {data.planos.map((plano) => (
            <li>
              <PlanoEmbed title={plano.title || plano.url} pdf={plano.url} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="tech mt-6 border p-4 text-sm" style="border-color: var(--line); color: var(--muted)">
          TODO: planos pendientes (subir los PDF desde el panel).
        </p>
      )
    }

    <div class="prose mt-8 max-w-prose" set:html={html} />
  </article>
</Base>

<style>
  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2rem;
  }
  .prose :global(p) {
    margin-top: 0.75rem;
  }
</style>
