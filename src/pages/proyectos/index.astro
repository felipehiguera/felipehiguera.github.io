---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getDB, listarProyectos } from "../../db/portfolio";

const proyectos = await listarProyectos(getDB());
---

<Base
  title="Proyectos — Felipe Higuera"
  description="Casos de estudio de dibujo técnico industrial, CAD/CAM y soporte IT: planimetría normada, corte CNC, despiece, QA de planos y soporte."
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold">Proyectos</h1>
    <p class="mt-2 max-w-prose" style="color: var(--muted)">
      {proyectos.length} casos de estudio: planos, modelos y proceso.
    </p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        proyectos.map((proyecto) => (
          <li>
            <ProjectCard proyecto={proyecto} nivel={2} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>
