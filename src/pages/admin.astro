---
import Base from "../layouts/Base.astro";
import { baseUrl } from "../utils/base";

/**
 * Panel de administración.
 *
 * Estático como el resto del sitio: no hay servidor ni base de datos. El
 * login lo hace Cloudflare Access antes de servir esta página y las
 * escrituras van al Worker `/api/admin`, que es el único que conoce el
 * token de GitHub.
 *
 * Va con `noindex` y fuera del sitemap: no tiene nada que un buscador deba
 * indexar.
 *
 * Diseño: pensado para un cliente no técnico. Una sola columna, cada campo
 * con su etiqueta visible, errores junto al campo, y la acción de guardar
 * siempre a la vista. Los estados (borrador, destacado) se ven en la lista,
 * no hay que abrir nada para saberlos.
 */
const base = baseUrl();
---

<Base
  title="Administración"
  description="Panel de administración del portafolio."
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-2xl font-bold">Administración</h1>
      <a href={base}>← Volver al sitio</a>
    </div>

    <div id="aviso" class="mt-4" role="status" hidden></div>

    <section id="panel" class="mt-8" data-base={base}>
      <p class="tech text-xs muted">
        Protegido por Cloudflare Access. Guardar escribe en el repo y dispara
        el deploy: el sitio se actualiza solo en ~1 minuto.
      </p>

      <div class="mt-8">
        <h2 class="text-lg font-semibold">Secciones visibles</h2>
        <p class="text-sm muted">
          Apagan el link del menú y el módulo del home. La ruta directa sigue
          respondiendo.
        </p>
        <div id="secciones" class="mt-3 grid gap-2"></div>
      </div>

      <div class="mt-10">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-lg font-semibold">Proyectos</h2>
          <button id="nuevo-proyecto" type="button" class="btn">
            + Nuevo proyecto
          </button>
        </div>
        <p id="resumen" class="tech mt-2 text-xs muted"></p>
        <ul id="lista" class="mt-3 grid gap-3"></ul>
      </div>

      <form id="editor" hidden class="mt-10" novalidate>
        <div class="tarjeta">
          <div class="tarjeta-cabeza">
            <h2 id="editor-titulo" class="text-lg font-semibold">
              Nuevo proyecto
            </h2>
            <p id="ruta" class="tech break-all text-xs muted"></p>
          </div>

          <div id="errores" class="caja-error" hidden>
            <p class="font-semibold">Faltan datos para guardar:</p>
            <ul id="errores-lista" class="mt-1"></ul>
          </div>

          <fieldset>
            <legend>Datos del proyecto</legend>
            <label class="grid gap-1">
              <span class="etiqueta">
                Título <span class="req" aria-hidden="true">*</span>
              </span>
              <input name="title" required class="campo" autocomplete="off" />
              <span class="pista">El nombre que se ve en la tarjeta y la página.</span>
              <span class="error-campo" data-err-for="title" hidden>
                Poné un título.
              </span>
            </label>

            <label class="grid gap-1">
              <span class="etiqueta">Slug (nombre del archivo)</span>
              <input
                name="slug"
                class="campo tech"
                autocomplete="off"
                placeholder="se-genera-del-titulo"
              />
              <span class="pista">
                Solo al crear. Después no se cambia para no romper links.
              </span>
            </label>

            <label class="grid gap-1">
              <span class="etiqueta">
                Resumen <span class="req" aria-hidden="true">*</span>
              </span>
              <input
                name="summary"
                required
                class="campo"
                autocomplete="off"
                maxlength="200"
              />
              <span class="pista">Una o dos líneas. Se ve en la tarjeta.</span>
              <span class="error-campo" data-err-for="summary" hidden>
                Poné un resumen.
              </span>
            </label>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1">
                <span class="etiqueta">
                  Fecha <span class="req" aria-hidden="true">*</span>
                </span>
                <input type="date" name="date" required class="campo" />
                <span class="error-campo" data-err-for="date" hidden>
                  Elegí una fecha.
                </span>
              </label>
              <label class="grid gap-1">
                <span class="etiqueta">Categoría</span>
                <select name="category" class="campo">
                  <option value="dibujo-tecnico">Dibujo técnico</option>
                  <option value="cad-cam">CAD/CAM</option>
                  <option value="soporte-it">Soporte IT</option>
                </select>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Contenido técnico</legend>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1">
                <span class="etiqueta">Software</span>
                <input
                  name="software"
                  class="campo"
                  autocomplete="off"
                  placeholder="Solid Edge, AutoCAD"
                />
                <span class="pista">Separado por coma.</span>
              </label>
              <label class="grid gap-1">
                <span class="etiqueta">Normativa</span>
                <input
                  name="normativa"
                  class="campo"
                  autocomplete="off"
                  placeholder="ISO 128, ANSI Y14.5"
                />
                <span class="pista">Separada por coma.</span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Portada y modelo</legend>
            <label class="grid gap-1">
              <span class="etiqueta">Portada actual</span>
              <input
                name="cover"
                class="campo tech"
                autocomplete="off"
                placeholder="Sin portada"
              />
              <span class="pista">
                Se completa sola al subir. Vacía = marco placeholder.
              </span>
            </label>
            <div class="grid gap-1">
              <span class="etiqueta">Cambiar portada</span>
              <div class="flex flex-wrap items-center gap-3">
                <input id="portada-file" type="file" accept="image/*" class="text-sm" />
              </div>
              <p id="portada-estado" class="tech text-xs muted"></p>
              <p class="text-xs muted">
                Se achica a 1600 px y se convierte a WebP al guardar.
              </p>
            </div>
            <label class="grid gap-1">
              <span class="etiqueta">Modelo 3D actual</span>
              <input
                name="model"
                class="campo tech"
                autocomplete="off"
                placeholder="Sin modelo"
              />
              <span class="pista">Archivo .glb en R2. Vacío = aviso de pendiente.</span>
            </label>
            <div class="grid gap-1">
              <span class="etiqueta">Cambiar modelo</span>
              <div class="flex flex-wrap items-center gap-3">
                <input id="modelo-file" type="file" accept=".glb,.gltf" class="text-sm" />
              </div>
              <p id="modelo-estado" class="tech text-xs muted"></p>
            </div>
          </fieldset>

          <fieldset>
            <legend>Planos (PDF)</legend>
            <ul id="planos-lista" class="grid gap-2"></ul>
            <div class="grid gap-2 border p-3">
              <span class="etiqueta">Agregar plano</span>
              <label class="grid gap-1">
                <span class="text-xs muted">Título del plano</span>
                <input
                  id="plano-titulo"
                  class="campo"
                  autocomplete="off"
                  placeholder="Lámina 01 — Planta"
                />
              </label>
              <div class="flex flex-wrap items-center gap-3">
                <input id="plano-file" type="file" accept=".pdf" class="text-sm" />
                <button id="plano-agregar" type="button" class="btn">
                  Agregar a la lista
                </button>
              </div>
              <p class="text-xs muted">
                Se sube al guardar el proyecto, junto con todo lo demás.
              </p>
            </div>
          </fieldset>

          <fieldset>
            <legend>Visibilidad</legend>
            <div class="grid gap-2 sm:grid-cols-2">
              <label class="opcion">
                <input type="radio" name="estado" value="publicado" />
                <span>
                  <strong>Publicado</strong>
                  <small>Visible en listados, con su página.</small>
                </span>
              </label>
              <label class="opcion">
                <input type="radio" name="estado" value="borrador" />
                <span>
                  <strong>Borrador</strong>
                  <small>Oculto y sin ruta. Para trabajar tranquilo.</small>
                </span>
              </label>
            </div>
            <label class="check">
              <input type="checkbox" name="featured" />
              <span>
                <strong>Destacado en el home</strong>
                <small>Aparece en el carrusel principal.</small>
              </span>
            </label>
            <label class="check">
              <input type="checkbox" name="confidential" />
              <span>
                <strong>Confidencial</strong>
                <small>Muestra el aviso y el material se ve redactado.</small>
              </span>
            </label>
          </fieldset>

          <fieldset>
            <legend>Texto del caso</legend>
            <label class="grid gap-1">
              <span class="etiqueta">Contenido (Markdown)</span>
              <textarea name="body" rows="14" class="campo tech"></textarea>
              <span class="pista">
                Secciones: Contexto y problema · Proceso · Normativa aplicada ·
                Software · Entregable · Resultado. `##` para títulos.
              </span>
            </label>
          </fieldset>

          <div class="barra">
            <button id="guardar" type="submit" class="btn primario">
              Guardar proyecto
            </button>
            <button id="cancelar" type="button" class="btn">Cancelar</button>
            <span id="guardando" class="tech text-xs muted" hidden>
              Guardando…
            </span>
          </div>
        </div>
      </form>

      <div id="exito" class="caja-exito" hidden>
        <p class="font-semibold">Guardado.</p>
        <p class="mt-1 text-sm">
          El sitio se actualiza solo en ~1 minuto.
          <a id="exito-ver" href="#" target="_blank" rel="noopener" hidden>
            Ver página →
          </a>
        </p>
        <div class="mt-3 flex flex-wrap gap-3">
          <button id="exito-seguir" type="button" class="btn">
            Seguir editando
          </button>
          <button id="exito-cerrar" type="button" class="btn">Cerrar</button>
        </div>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  /*
   * Global ceñido a #panel a propósito: la lista, los toggles y las
   * insignias los crea el JS en el navegador, y el scope automático de
   * Astro (data-astro-cid en el HTML del servidor) nunca los alcanza.
   * Todo va prefijado con #panel para no fugar al resto del sitio.
   */
  #panel .campo {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    padding: 0.65rem 0.8rem;
    border-radius: 0.375rem;
    font: inherit;
    transition: border-color 0.15s ease;
  }

  #panel .campo:hover {
    border-color: var(--muted);
  }

  #panel .campo:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  #panel textarea.campo {
    line-height: 1.65;
    min-height: 16rem;
    resize: vertical;
  }

  #panel input[type="file"] {
    max-width: 100%;
  }

  #panel input[type="file"]::file-selector-button {
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--accent-ink);
    padding: 0.45rem 0.9rem;
    border-radius: 0.375rem;
    font: inherit;
    cursor: pointer;
    margin-right: 0.75rem;
  }

  #panel input[type="file"]::file-selector-button:hover {
    border-color: var(--accent);
  }

  #panel .campo[aria-invalid="true"] {
    border-color: #b3261e;
  }

  #panel .etiqueta {
    font-size: 0.875rem;
    font-weight: 600;
  }

  #panel .req {
    color: #b3261e;
  }

  #panel .pista {
    font-size: 0.78rem;
    color: var(--muted);
  }

  #panel .error-campo {
    font-size: 0.82rem;
    color: #b3261e;
  }

  #panel .btn {
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--accent-ink);
    padding: 0.55rem 1.1rem;
    border-radius: 0.375rem;
    cursor: pointer;
    font: inherit;
    min-height: 2.75rem;
  }

  #panel .btn:hover {
    border-color: var(--accent);
  }

  #panel .btn:disabled {
    opacity: 0.5;
    cursor: default;
  }

  #panel .btn.primario {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  @media (prefers-color-scheme: dark) {
    #panel .btn.primario {
      color: #101418;
    }
  }

  #panel .btn.peligro {
    color: #b3261e;
  }

  #panel .muted {
    color: var(--muted);
  }

  #panel .small {
    font-size: 0.75rem;
  }

  #panel .break-all {
    overflow-wrap: anywhere;
  }

  /* Tarjeta del editor: secciones separadas con aire. */
  #panel .tarjeta {
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: grid;
    gap: 1.75rem;
    background: var(--bg);
  }

  @media (min-width: 640px) {
    #panel .tarjeta {
      padding: 2rem;
    }
  }

  #panel .tarjeta fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.1rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  #panel .tarjeta fieldset:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  #panel .tarjeta legend {
    font-weight: 700;
    font-size: 1.02rem;
    padding: 0;
    margin-bottom: 0.25rem;
  }

  #panel .tarjeta-cabeza {
    display: grid;
    gap: 0.25rem;
  }

  /* Barra de acciones siempre visible al pie del formulario. */
  #panel .barra {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg);
    border-top: 1px solid var(--line);
    padding: 1rem 0 0.25rem;
  }

  #panel .barra .btn.primario {
    padding: 0.65rem 1.6rem;
  }

  /* Opciones de visibilidad como tarjetas elegibles. */
  #panel .opcion,
  #panel .check {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    padding: 0.7rem 0.85rem;
    cursor: pointer;
  }

  #panel .opcion:has(input:checked) {
    border-color: var(--accent);
  }

  #panel .opcion strong,
  #panel .check strong {
    display: block;
    font-size: 0.9rem;
  }

  #panel .opcion small,
  #panel .check small {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
  }

  #panel .opcion input,
  #panel .check input {
    margin-top: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
    flex-shrink: 0;
  }

  #panel .check {
    margin-top: 0.5rem;
  }

  #panel .check input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
  }

  #panel .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.75rem 0.9rem;
  }

  #panel .fila.toggle {
    justify-content: flex-start;
    gap: 0.6rem;
    cursor: pointer;
  }

  #panel .fila.toggle input[type="checkbox"] {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--accent);
    flex-shrink: 0;
  }

  #panel .fila-info {
    display: grid;
    gap: 0.15rem;
  }

  #panel .fila-nombre {
    font-weight: 600;
  }

  #panel .fila-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  #panel .fila-acciones .btn {
    min-height: 2.75rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  #panel .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  #panel .chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
    color: var(--muted);
  }

  #panel .chip.alerta {
    color: #b3261e;
    border-color: #b3261e;
  }

  #panel .chip.ok {
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  #panel .caja-error {
    border: 1px solid #b3261e;
    border-radius: 0.375rem;
    padding: 0.75rem 1rem;
    color: #b3261e;
    font-size: 0.9rem;
  }

  #panel .caja-error ul {
    list-style: disc;
    padding-left: 1.25rem;
  }

  #panel .caja-exito {
    border: 1px solid var(--accent);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin-top: 1.5rem;
  }
</style>

<script>
  import "../scripts/admin";
</script>
