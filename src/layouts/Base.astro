---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { baseUrl } from "../utils/base";
import { getDB, leerSecciones } from "../db/portfolio";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** `website` por defecto; los casos de estudio pasan `article`. */
  ogType?: "website" | "article";
  /** Fecha ISO 8601, para `article:published_time` (solo casos de estudio). */
  publishedTime?: string;
  /** Sección editorial, para `article:section` (solo casos de estudio). */
  section?: string;
  /** Emite `robots: noindex` (se usa en `/admin`). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = "website",
  publishedTime,
  section,
  noindex = false,
} = Astro.props;
const base = baseUrl();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
// En build estático `Astro.url.pathname` ya es la ruta "pretty" (con barra
// final, sin `index.html`). El replace es una red de seguridad por si algún día
// se cambia `build.format`.
const pageUrl = `${siteUrl}${Astro.url.pathname.replace(/index\.html$/, "")}`;
const siteName = "Felipe Higuera";
// Las secciones viven en D1: el nav refleja el toggle al instante.
let secciones: Record<string, boolean> = {};
try {
  secciones = await leerSecciones(getDB());
} catch {
  secciones = {};
}
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />

    <!--
      El tema claro/oscuro se resuelve solo con `prefers-color-scheme` en
      `global.css`. Declarar `color-scheme` hace que los controles propios del
      navegador (scrollbars, campos, canvas) acompasen el tema en vez de
      quedar con el claro por defecto.
    -->
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#101418"
      media="(prefers-color-scheme: dark)"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="es_CL" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {section && <meta property="article:section" content={section} />}
    <!--
      TODO: falta `og:image` / `twitter:image`. Sin un asset 1200x630 en
      `public/` no se puede emitir sin inventarlo; cuando exista, la tarjeta
      debería pasar a `summary_large_image`.
    -->
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header secciones={secciones} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>